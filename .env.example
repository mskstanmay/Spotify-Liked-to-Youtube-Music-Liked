SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_WEB_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Web service
# Use APP_ENV=staging with NODE_ENV=production for a staging deployment.
NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/musicmove
# Required only for APP_ENV=staging. Use the unique staging database/project
# identifier that appears in the DATABASE_URL username, hostname, or database name.
STAGING_DATABASE_IDENTIFIER=
API_BASE_URL=http://127.0.0.1:3000
WEB_BASE_URL=http://127.0.0.1:5173
SESSION_SECRET=
# Base64-encoded 32-byte key. Generate locally; never commit its value.
TOKEN_ENCRYPTION_KEY=
SESSION_DAYS=30
PORT=3000
HOST=127.0.0.1

# Google web OAuth / official YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
WORKER_POLL_MS=1500
WORKER_LEASE_MS=60000
WORKER_READY_MAX_AGE_MS=60000
PYTHON_SUBPROCESS_TIMEOUT_MS=30000
YTMUSIC_AUTH_TIMEOUT_MS=600000
# Optional hard server-side scope for controlled migrations (for example 3).
# Leave blank to retain full-library migrations.
MIGRATION_MAX_TRACKS=
# Safe MEDIUM matches at or above this score are processed and flagged for review.
AUTO_REVIEW_MIN_SCORE=0.72

# Legacy local CLI ytmusicapi settings only. Never expose these files in the web UI.
YTMUSIC_AUTH_PATH=data/ytmusic-oauth.json
YTMUSIC_BROWSER_AUTH_PATH=data/ytmusic-browser.json
YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=
YTMUSIC_SEARCH_LIMIT=10
YTMUSIC_LIKED_SONGS_LIMIT=10000

MATCH_CONFIDENCE_THRESHOLD=0.85
REQUEST_DELAY_MS=250
MAX_RETRIES=3
DEBUG_SYNC=false
